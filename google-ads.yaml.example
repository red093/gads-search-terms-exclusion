# Google Ads API Configuration File
#
# Copy this file to 'google-ads.yaml' and fill in your credentials
#
# cp google-ads.yaml.example google-ads.yaml
#
# IMPORTANT: Never commit google-ads.yaml with real credentials to version control!

# Your Google Ads Developer Token
# Get it from: Google Ads Manager > Tools & Settings > API Center
developer_token: YOUR_DEVELOPER_TOKEN

# OAuth2 Client ID from Google Cloud Console
# Get it from: https://console.cloud.google.com/apis/credentials
client_id: YOUR_CLIENT_ID.apps.googleusercontent.com

# OAuth2 Client Secret from Google Cloud Console
client_secret: YOUR_CLIENT_SECRET

# OAuth2 Refresh Token
# Generate it using: python generate_refresh_token.py
# (Make sure to activate the virtual environment first)
refresh_token: YOUR_REFRESH_TOKEN

# Login Customer ID (without hyphens)
# ==========================================
# SCENARIO 1: Direct Account Access
# If you're accessing your own Google Ads account directly, use your account ID
# Example: 1234567890
#
# SCENARIO 2: MCC (Manager) Account Access
# If you're an agency or have a Google Ads Manager (MCC) account managing multiple
# client accounts, use your MCC account ID here.
# Example: 9876543210 (your MCC account)
#
# Then when running the script, use --customer-id with the client account ID:
# python search_terms_analyzer.py --customer-id 1234567890
#
# NOTE: You can also override this value via command line using --login-customer-id
login_customer_id: YOUR_LOGIN_CUSTOMER_ID

# Use proto-plus (recommended)
use_proto_plus: True
